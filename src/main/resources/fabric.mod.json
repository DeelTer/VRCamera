{
	"schemaVersion": 1,
	"id": "vrcamera",
	"version": "${version}",
	"name": "VRCamera",
	"description": "Cinematic follow camera and auto director: for the Vivecraft handheld camera in VR, and for a camera of its own at a screen",
	"authors": [
		"DeelTer"
	],
	"contact": {},
	"license": "GPL-3.0-only",
	"icon": "assets/vrcamera/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"ru.deelter.vrcamera.client.VrcameraClient"
		],
		"modmenu": [
			"ru.deelter.vrcamera.client.gui.ModMenuIntegration"
		],
		"frex_flawless_frames": [
			"ru.deelter.vrcamera.client.desktop.FlawlessFrames"
		],
		"figura_api": [
			"ru.deelter.vrcamera.client.figura.FiguraEyes"
		]
	},
	"mixins": [
		{
			"config": "vrcamera.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "vrcamera.vivecraft.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"fabric-api": "*",
		"minecraft": "${minecraft_version}"
	},
	"recommends": {
		"vivecraft": "*"
	},
	"suggests": {
		"cloth-config": "*",
		"figura": "*",
		"modmenu": "*"
	}
}
